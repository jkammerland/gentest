file(WRITE "${CMAKE_BINARY_DIR}/parent-config-loaded"
  "${gentest_FIND_VERSION}|${gentest_FIND_VERSION_EXACT}|${gentest_FIND_COMPONENTS}")
set(gentest_VERSION 2.0.0)
set(gentest_FOUND TRUE)
foreach(_component IN LISTS gentest_FIND_COMPONENTS)
  if(_component STREQUAL "runtime")
    set(gentest_${_component}_FOUND TRUE)
  else()
    set(gentest_${_component}_FOUND FALSE)
    if(gentest_FIND_REQUIRED_${_component})
      set(gentest_FOUND FALSE)
      set(gentest_NOT_FOUND_MESSAGE "parent component policy rejected the request")
    endif()
  endif()
endforeach()
include("@GENTEST_SOURCE_DIR@/cmake/GentestCodegen.cmake")
