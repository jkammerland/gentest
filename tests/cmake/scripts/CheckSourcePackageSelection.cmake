# Configure a source provider and a sibling package requester with a conflicting
# installation in the normal search path. Parent redirects retain their policy.
# Requires BUILD_ROOT, SOURCE_DIR (fixture), GENTEST_SOURCE_DIR, GENERATOR and CASE.
foreach(_required IN ITEMS BUILD_ROOT SOURCE_DIR GENTEST_SOURCE_DIR GENERATOR CASE)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "CheckSourcePackageSelection.cmake: ${_required} not set")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/CheckRunOrFail.cmake")
include(CMakePackageConfigHelpers)

# Keep nested compiler-probe paths short, including in Windows CI checkouts.
string(MD5 _case_hash "${CASE}")
string(SUBSTRING "${_case_hash}" 0 8 _case_hash)
set(_work "${BUILD_ROOT}/sp_${_case_hash}")
set(_build "${_work}/b")
set(_prefix "${_work}/i")
set(_package "${_prefix}/share/cmake/gentest")
gentest_remove_fixture_path("${_work}")
file(MAKE_DIRECTORY "${_package}")

# Model the legacy installed config's helper-before-target ordering. Its helper
# has no new guard: it must be stopped at its original directory assignment.
file(WRITE "${_package}/gentestConfig.cmake" [=[
file(WRITE "${CMAKE_BINARY_DIR}/foreign-config-loaded" "${CMAKE_CURRENT_LIST_FILE}")
include("${CMAKE_CURRENT_LIST_DIR}/GentestCodegen.cmake")
if(NOT TARGET gentest::gentest_runtime)
  add_library(gentest::gentest_runtime INTERFACE IMPORTED GLOBAL)
endif()
set(gentest_FOUND TRUE)
set(gentest_VERSION 1.2.2)
]=])
file(WRITE "${_package}/GentestCodegen.cmake" [=[
include_guard(GLOBAL)
set(_GENTEST_CODEGEN_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
file(WRITE "${CMAKE_BINARY_DIR}/foreign-helpers-loaded" "${CMAKE_CURRENT_LIST_FILE}")
function(gentest_attach_codegen target)
  message(FATAL_ERROR "The legacy codegen stub must not be called")
endfunction()
function(gentest_link_mocks target)
  target_link_libraries(${target} ${ARGN})
endfunction()
]=])
write_basic_package_version_file("${_package}/gentestConfigVersion.cmake"
  VERSION 1.2.2 COMPATIBILITY SameMajorVersion ARCH_INDEPENDENT)

set(_configure "${CMAKE_COMMAND}" -G "${GENERATOR}")
if(NOT "${GENERATOR_PLATFORM}" STREQUAL "")
  list(APPEND _configure -A "${GENERATOR_PLATFORM}")
endif()
if(NOT "${GENERATOR_TOOLSET}" STREQUAL "")
  list(APPEND _configure -T "${GENERATOR_TOOLSET}")
endif()
foreach(_cache_key IN ITEMS CMAKE_TOOLCHAIN_FILE CMAKE_MAKE_PROGRAM CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_BUILD_TYPE)
  string(REGEX REPLACE "^CMAKE_" "" _input_key "${_cache_key}")
  if(NOT "${${_input_key}}" STREQUAL "")
    list(APPEND _configure "-D${_cache_key}=${${_input_key}}")
  endif()
endforeach()
if(NOT "${CXX_COMPILER}" STREQUAL "")
  gentest_append_windows_native_llvm_cache_args(_configure "${CXX_COMPILER}" ${_configure})
endif()
list(APPEND _configure -S "${SOURCE_DIR}" -B "${_build}"
  "-DGENTEST_SOURCE_DIR=${GENTEST_SOURCE_DIR}" "-DCASE=${CASE}"
  "-DFOREIGN_PACKAGE_DIR=${_package}" "-DFOREIGN_PREFIX=${_prefix}"
  --trace-expand --trace-format=json-v1 "--trace-redirect=${_work}/trace.jsonl")
execute_process(COMMAND ${_configure} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
set(_output "${_out}\n${_err}")
file(WRITE "${_work}/configure.log" "${_output}")

# Reject replacing a legacy installation's already loaded helpers as well.
if(CASE STREQUAL "installed_then_source")
  if(_rc EQUAL 0 OR NOT _output MATCHES "gentest: conflicting CMake helpers")
    message(FATAL_ERROR "${CASE}: source helpers replaced an earlier installation:\n${_output}")
  endif()
  if(NOT EXISTS "${_build}/foreign-helpers-loaded")
    message(FATAL_ERROR "${CASE}: the earlier installed helper was not exercised")
  endif()
  return()
endif()

# Both REQUIRED and QUIET must refuse a real installed fallback after the
# parent's version policy rejects the redirect. Check entry and overwrite apart.
if(CASE MATCHES "^(mixed_|parent_reject_)")
  if(_rc EQUAL 0 OR NOT _output MATCHES "gentest: conflicting CMake helpers")
    message(FATAL_ERROR "${CASE}: expected a helper-origin error, got ${_rc}:\n${_output}")
  endif()
  if(NOT EXISTS "${_build}/foreign-config-loaded" OR EXISTS "${_build}/foreign-helpers-loaded")
    message(FATAL_ERROR "${CASE}: the installed config must be reached without loading its helpers")
  endif()
  if(CASE MATCHES "^parent_reject_")
    if(NOT EXISTS "${_build}/parent-version-rejected")
      message(FATAL_ERROR "${CASE}: the parent's version rejection was not exercised")
    endif()
    file(READ "${_build}/parent-version-rejected" _version_request)
    if(NOT _version_request STREQUAL "1.2.2")
      message(FATAL_ERROR "${CASE}: the version request was changed: '${_version_request}'")
    endif()
  endif()
  return()
endif()

# A required-component failure must retain standard find_package semantics.
if(CASE STREQUAL "parent_component_required")
  if(_rc EQUAL 0 OR NOT _output MATCHES "parent component policy rejected the request")
    message(FATAL_ERROR "${CASE}: expected the parent's component rejection:\n${_output}")
  endif()
  if(EXISTS "${_build}/foreign-config-loaded")
    message(FATAL_ERROR "${CASE}: component rejection fell through to the installed package")
  endif()
  return()
endif()
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "${CASE}: configure failed (${_rc}):\n${_output}")
endif()
if(NOT CASE STREQUAL "installed_only" AND EXISTS "${_build}/foreign-config-loaded")
  message(FATAL_ERROR "${CASE}: unexpectedly loaded the installed config")
endif()

# Inspect the executing function's trace location, not a helper-owned variable.
if(CASE STREQUAL "installed_only")
  set(_expected_helper "${_package}/GentestCodegen.cmake")
else()
  set(_expected_helper "${GENTEST_SOURCE_DIR}/cmake/gentest/TuMode.cmake")
endif()
file(REAL_PATH "${_expected_helper}" _expected_helper)
file(STRINGS "${_work}/trace.jsonl" _calls REGEX "target_link_libraries.*package_consumer|package_consumer.*target_link_libraries")
set(_checked FALSE)
foreach(_call IN LISTS _calls)
  string(JSON _command GET "${_call}" cmd)
  string(JSON _target GET "${_call}" args 0)
  if(_command STREQUAL "target_link_libraries" AND _target STREQUAL "package_consumer")
    string(JSON _file GET "${_call}" file)
    file(REAL_PATH "${_file}" _file)
    if(NOT _file STREQUAL _expected_helper)
      message(FATAL_ERROR "${CASE}: public helper executed from '${_file}', expected '${_expected_helper}'")
    endif()
    set(_checked TRUE)
  endif()
endforeach()
if(NOT _checked)
  message(FATAL_ERROR "${CASE}: no public helper execution was checked")
endif()
