{
  "name": "gentest",
  "version": "1.1.0",
  "description": "Attribute-driven test discovery with clang tooling",
  "dependencies": [
    "fmt",
    "zlib",
    "zstd",
    "libxml2"
  ],
  "features": {
    "allure-boost-json": {
      "description": "Optional Boost.JSON headers for the Allure writer",
      "dependencies": [
        "boost-json"
      ]
    },
    "record-glaze": {
      "description": "Optional C++23 JSON recording adapter",
      "dependencies": [
        "glaze"
      ]
    },
    "record-cbor": {
      "description": "Optional C++20 CBOR recording adapter",
      "dependencies": [
        "cbor-tags"
      ]
    }
  }
}
