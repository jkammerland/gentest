cmake_minimum_required(VERSION 3.31)

# CMake writes its evaluated module dependency graph at generate time, including
# synthetic targets for imported BMIs. Follow the same edges as its collator.
set(queue "${TARGET_DIR}")
set(visited "")
set(objects "")
while(queue)
    list(POP_FRONT queue dir)
    if(dir IN_LIST visited)
        continue()
    endif()
    list(APPEND visited "${dir}")

    file(READ "${dir}/CXXDependInfo.json" info)
    foreach(edge IN ITEMS linked-target-dirs forward-modules-from-target-dirs)
        string(JSON count LENGTH "${info}" "${edge}")
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON next GET "${info}" "${edge}" ${index})
                list(APPEND queue "${next}")
            endforeach()
        endif()
    endforeach()

    # The attached target's authored inputs already have their own commands.
    if(dir STREQUAL TARGET_DIR)
        continue()
    endif()
    string(JSON count LENGTH "${info}" cxx-modules)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON object MEMBER "${info}" cxx-modules ${index})
            file(TO_CMAKE_PATH "${object}" object)
            list(APPEND objects "${object}")
        endforeach()
    endif()
endwhile()

set(entries "")
if(objects)
    # Restrict Ninja's database to the compiler rules owning these outputs.
    # -x expands native response files even before the first compilation.
    execute_process(COMMAND "${NINJA}" -f "${MANIFEST}" -t query ${objects}
        OUTPUT_VARIABLE query ERROR_VARIABLE diagnostics RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "gentest: cannot query provider objects: ${diagnostics}")
    endif()
    string(REGEX MATCHALL "\n  input: [^\r\n]+" rules "${query}")
    list(TRANSFORM rules REPLACE "^\n  input: " "")
    list(REMOVE_DUPLICATES rules)
    execute_process(COMMAND "${NINJA}" -f "${MANIFEST}" -t compdb -x ${rules}
        OUTPUT_VARIABLE database COMMAND_ERROR_IS_FATAL ANY)

    string(JSON count LENGTH "${database}")
    if(count EQUAL 0)
        message(FATAL_ERROR "gentest: Ninja returned no module provider compile commands")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON object GET "${database}" ${index} output)
        file(TO_CMAKE_PATH "${object}" object)
        if(object IN_LIST objects)
            string(JSON entry GET "${database}" ${index})
            if(entries)
                string(APPEND entries ",\n")
            endif()
            string(APPEND entries "${entry}")
            list(REMOVE_ITEM objects "${object}")
        endif()
    endforeach()
    if(objects)
        message(FATAL_ERROR "gentest: missing module provider compile commands for: ${objects}")
    endif()
endif()

# Preserve the timestamp across reconfiguration when the commands are identical.
set(contents "[\n${entries}\n]\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(contents STREQUAL previous)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${contents}")
