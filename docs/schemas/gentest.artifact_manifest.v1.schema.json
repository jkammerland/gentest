{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentest.dev/schemas/gentest.artifact_manifest.v1.schema.json",
  "title": "gentest artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sources", "artifacts"],
  "properties": {
    "schema": {
      "const": "gentest.artifact_manifest.v1"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "kind",
              "scan_source",
              "scan_slot_kind",
              "compile_context_id",
              "compile_context_fingerprint",
              "registration_output"
            ],
            "properties": {
              "source": { "type": "string" },
              "kind": { "const": "cxx-header-declaration-registration" },
              "scan_source": { "type": "string" },
              "scan_slot_kind": { "enum": ["authored-tu", "fallback-header"] },
              "compile_context_id": { "type": "string" },
              "compile_context_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "registration_output": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "kind",
              "module",
              "partition",
              "compile_context_id",
              "registration_output"
            ],
            "properties": {
              "source": { "type": "string" },
              "kind": {
                "const": "module-primary-interface"
              },
              "module": { "type": "string" },
              "partition": {
                "type": "null"
              },
              "compile_context_id": { "type": "string" },
              "registration_output": { "type": "string" }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "compile_as",
              "owner_source",
              "target_attachment",
              "compile_context_id",
              "compile_context_fingerprint",
              "requires_module_scan",
              "includes_authored_source",
              "replaces_authored_source",
              "depfile"
            ],
            "properties": {
              "path": { "type": "string" },
              "role": { "const": "registration" },
              "compile_as": { "const": "cxx-header-declaration-registration" },
              "owner_source": { "type": "string" },
              "target_attachment": { "const": "append-generated-source" },
              "compile_context_id": { "type": "string" },
              "compile_context_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "requires_module_scan": { "const": false },
              "includes_authored_source": { "const": false },
              "replaces_authored_source": { "const": false },
              "depfile": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "compile_as",
              "module",
              "owner_source",
              "target_attachment",
              "compile_context_id",
              "requires_module_scan",
              "generated_include_dirs",
              "generated_headers",
              "depfile"
            ],
            "properties": {
              "path": { "type": "string" },
              "role": { "const": "registration" },
              "compile_as": { "const": "cxx-module-implementation" },
              "module": { "type": "string" },
              "owner_source": { "type": "string" },
              "target_attachment": { "const": "private-generated-source" },
              "compile_context_id": { "type": "string" },
              "requires_module_scan": { "const": true },
              "generated_include_dirs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "type": "string" }
              },
              "generated_headers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "type": "string" }
              },
              "depfile": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "compile_as",
              "module",
              "imports",
              "owner_source",
              "target_attachment",
              "compile_context_id",
              "requires_module_scan",
              "generated_include_dirs",
              "generated_headers",
              "depfile"
            ],
            "properties": {
              "path": { "type": "string" },
              "role": { "const": "registration" },
              "compile_as": { "const": "cxx-module-importer-registration" },
              "module": { "type": "string" },
              "imports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "type": "string" }
              },
              "owner_source": { "type": "string" },
              "target_attachment": { "const": "private-generated-source" },
              "compile_context_id": { "type": "string" },
              "requires_module_scan": { "const": true },
              "generated_include_dirs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "type": "string" }
              },
              "generated_headers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "type": "string" }
              },
              "depfile": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
